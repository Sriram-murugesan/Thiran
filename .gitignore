# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.eggs/
dist/
build/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# pytest / coverage
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/

# Editors
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Model cache (downloaded at runtime — do not commit)
~/.cache/huggingface/
~/.cache/whisper/
~/.local/share/tts/

# Local config override (has secrets / local paths)
config/config.local.yaml
.env
.env.*

# Audio files captured during testing
*.wav
*.mp3

# Secrets (Gmail integration)
credentials.json
token.json
